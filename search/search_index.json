{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6ce5\u568e\u670b\u53cb","text":"<p>\u8be5\u7f51\u7ad9\u4ec5\u7528\u6765\u8bb0\u5f55\uff0c\u5b58\u653e\uff0c\u5c55\u793a\u4e2a\u4eba\u5b8c\u6574\u521b\u4f5c\u4f5c\u54c1\u3002\u73b0\u5728\u4ecd\u5728\u66f4\u65b0\u9020\u8c23\u70df\u8bed\u70df\uff0c\u5982\u679c\u6ca1\u66f4\u65b0\u5c31\u662f\u5728\u53e3\u55e8\u6478\u9c7c\uff0c\u6682\u65f6\u6ca1\u6709\u5f03\u5751\u8dd1\u8def\u7684\u60f3\u6cd5\u2014\u2014\u2014\u2014\u8a93\u6b7b\u6548\u5fe0\u5bb6\u4ea7\uff08\uff09</p> <ul> <li> <p> \u6587\u7ae0\u96c6</p> <p>\u65e0\u5220\u51cf\u5b8c\u6574\u7248\u5747\u4f1a\u540c\u6b65\u66f4\u65b0\u5230\u8be5\u6587\u96c6</p> <p> \u54c1\u9274\u4e00\u4e0b\u7f8e\u98df</p> </li> <li> <p> \u77ed\u6253\u7d20\u6750\u5e93</p> <p>\u653e\u4e00\u4e0b\u8111\u6d1e\u548c\u7075\u611f\uff0c\u6ca1\u6709\u610f\u5916\u7684\u60c5\u51b5\u4e0b\u4f1a\u6839\u636e\u53e3\u55e8\u5199\u6587</p> <p> \u53bb\u770b\u4e00\u773c</p> </li> <li> <p> \u5176\u4ed6</p> <p>\u653e\u4e00\u4e9b\u5e73\u65f6\u6478\u9c7c\u753b\u7684oc\u4ee5\u7559\u75d5</p> <p> \u5176\u4ed6</p> </li> </ul>"},{"location":"#_2","title":"\u788e\u788e\u5ff5","text":"<p>\u5199\u4e0d\u5b8c\uff0c\u6839\u672c\u5199\u4e0d\u5b8c\uff0c\u80fd\u81ea\u5df1\u5199\u753b\u7684\u7b14\u54ea\u91cc\u6709\u5f97\u4e0b\u5355\uff0c\u6025\u6025\u6025</p>"},{"location":"about/","title":"\u4e00\u4e9b\u8054\u7cfb\u65b9\u5f0f","text":"<ul> <li>qq\uff1a146085303\uff1b3380223158</li> <li>\u6df7\u5708\uff1aV\u5bb6\uff0c\u767e\u5408\uff0c\u97f3\u6e38\uff0c\u5d29\u574f\u661f\u7a79\u94c1\u9053\uff0c\u660e\u65e5\u65b9\u821f\uff0c\u660e\u65e5\u65b9\u821f\u7ec8\u672b\u5730\uff0c\u9e23\u6f6e\uff0c\u851a\u84dd\u6863\u6848...\uff08\u4ec5\u663e\u793a\u6ca1\u9000\u5751</li> <li>\u5c0f\u76ee\u6807\uff1a\u628a\u8111\u6d1e\u5168\u5199\u5b8c</li> </ul>"},{"location":"shorts/","title":"\u77ed\u6253\u7d20\u6750\u5e93","text":"<p>\u8fd9\u91cc\u5b58\u653e\u65e5\u5e38\u8bb0\u5f55\u7684\u77ed\u6253\u7247\u6bb5\u3001\u7075\u611f\u7d20\u6750\u4e0e\u788e\u788e\u5ff5\u3002</p> <p>\u540e\u7eed\u53ef\u4ee5\u76f4\u63a5\u5728\u8fd9\u4e2a\u6587\u4ef6\u5939\u91cc\u65b0\u5efa markdown \u6587\u4ef6\uff0c\u6bcf\u7bc7\u5c31\u662f\u4e00\u6761\u7d20\u6750\u3002</p>"},{"location":"blog/","title":"Blog","text":""},{"location":"blog/thingking/","title":"Blog","text":""},{"location":"blog/2026/11/24/%E6%96%87%E7%AB%A0%E6%A0%87%E9%A2%98/","title":"\u6587\u7ae0\u6807\u9898","text":"<p>\u6b63\u6587\u4ece\u8fd9\u91cc\u5f00\u59cb\u5199\u3002</p>"},{"location":"blog/2026/11/24/%E6%96%87%E7%AB%A0%E6%A0%87%E9%A2%98/#_2","title":"\u5c0f\u6807\u9898","text":"<ul> <li>\u5217\u8868\u9879\u4e00</li> <li>\u5217\u8868\u9879\u4e8c</li> </ul> <p>\u56fe\u7247\uff08\u628a\u56fe\u7247\u5148\u4f20\u5230 docs/assets/\uff09\uff1a</p> <p></p> <p>\u63d0\u793a\uff1a\u8fd9\u4e2a\u6587\u4ef6\u540d\u4ee5\u4e0b\u5212\u7ebf\u5f00\u5934\uff0cMkDocs \u4f1a\u5ffd\u7565\u5b83\uff0c\u4e0d\u4f1a\u88ab\u53d1\u5e03\u51fa\u53bb\u3002 \u771f\u7684\u5199\u65b0\u6587\u7ae0\u65f6\uff0c\u590d\u5236\u672c\u6587\u5185\u5bb9\u5230\u300cAdd file \u2192 Create new file\u300d\uff0c\u6587\u4ef6\u540d\u6539\u6210\u82f1\u6587\u5c0f\u5199\uff0c\u4f8b\u5982 <code>2026-11-24-\u6211\u7684\u7b2c\u4e00\u5929.md</code>\u3002</p>"},{"location":"blog/2026/07/29/%E6%8E%92%E5%8D%B5%E6%9C%9F/","title":"\u6392\u5375\u671f","text":"<p>#\u00a0\u9f99\u9e1f\u6709\u5dee\u2003#\u00a0\u6709\u9ece\u535a\u5229\u4ea7\u5375\u8bbe\u5b9a\u634f\u9020</p> <p>\u6765\u7ec8\u672b\u5730\u5e1d\u6c5f\u53f7\u517b\u4f24\u7684\u8fd9\u6bb5\u65f6\u95f4\uff0c\u674e\u7ec7\u70df\u8010\u4e0d\u4f4f\u95f2\u6687\u4e4b\u4f59\uff0c\u4e8e\u662f\u63a5\u4e86\u7ec8\u672b\u5730\u7684\u76f8\u5173\u4efb\u52a1\uff0c\u4f9d\u65e7\u51fa\u52e4\u65f6\u95f4\uff0c\u674e\u7ec7\u70df\u7167\u5e38\u5904\u7406\u4efb\u52a1\u3002</p> <p>\u5979\u5728\u5e1d\u6c5f\u53f7\u8fc7\u5f97\u5f88\u597d\uff0c\u7d27\u7ef7\u611f\u6e10\u6e10\u6d88\u5931\uff0c\u987a\u800c\u4ee3\u4e4b\u7684\u662f\u653e\u677e\uff0c\u66f4\u91cd\u8981\u7684\u662f\u5979\u7ec8\u4e8e\u80fd\u548c\u9648\u5343\u8bed\u5728\u4e00\u5757\uff0c\u867d\u7136\u5634\u4e0a\u5e76\u4e0d\u627f\u8ba4\uff0c\u4f46\u8fd8\u662f\u5168\u5fc3\u5168\u610f\u63a5\u53d7\u5e72\u5458\u9648\u5343\u8bed\u7684\u5173\u7167\u3002</p> <p>\u5979\u4eca\u5929\u7684\u4efb\u52a1\u5f88\u7b80\u5355\uff0c\u8f7b\u677e\u5f97\u4ee4\u5979\u4e00\u5ea6\u8ba4\u4e3a\u4e0d\u771f\u5b9e\uff0c\u4f46\u4e8b\u5b9e\u786e\u5b9e\u5982\u6b64\uff0c\u5979\u53ea\u9700\u8981\u53d1\u6325\u4f5c\u4e3a\u5e94\u9f99\u7279\u52e4\u961f\u961f\u957f\u7684\u80fd\u529b\u5206\u6790\u6570\u636e\uff0c\u7136\u540e\u7edf\u7b79\u6574\u7406\u3002</p> <p>\u5ffd\u7136\uff0c\u674e\u7ec7\u70df\u8eab\u5f62\u4e00\u50f5\uff0c\u5979\u611f\u5230\u4e0b\u8179\u4e00\u75db\uff0c\u63e1\u7740\u6570\u636e\u9762\u677f\u7684\u624b\u6307\u8737\u7f29\uff0c\u5bc6\u5bc6\u9ebb\u9ebb\u7684\u75db\u695a\u4ece\u8179\u90e8\u70b8\u5f00\u2014\u2014\u9ece\u535a\u5229\u7684\u6392\u5375\u671f\u3002</p> <p>\u201c\u5567\u201d\u610f\u8bc6\u5230\u4e0d\u5bf9\u7684\u65f6\u5019\uff0c\u5df2\u7ecf\u5403\u529b\u5730\u501a\u9760\u5728\u5899\u8fb9\uff0c\u9762\u8272\u6f6e\u7ea2\uff0c\u5979\u4f4e\u4e0b\u5934\u8bd5\u56fe\u9690\u5fcd\u8179\u90e8\u7684\u80c0\u75db\u611f\uff0c\u5f3a\u5236\u538b\u4e0b\u5404\u5904\u5171\u540c\u4f20\u6765\u7684\u4e0d\u9002\u611f\u540e\uff0c\u674e\u7ec7\u70df\u6525\u7d27\u624b\u4e2d\u7684\u9762\u677f\uff0c\u7ee7\u7eed\u5904\u7406\u5b8c\u4f59\u4e0b\u7684\u4efb\u52a1\u3002</p> <p>\u7ba1\u7406\u5458\u548c\u4f69\u4e3d\u5361\u662f\u5728\u524d\u5f80\u5e72\u5458\u8054\u7edc\u5904\u7684\u8def\u4e0a\u53d1\u73b0\u674e\u7ec7\u70df\u7684\uff0c\u5fc3\u601d\u672c\u5c31\u7f1c\u5bc6\u7684\u9ece\u535a\u5229\u6beb\u4e0d\u8d39\u529b\u5730\u5c31\u731c\u5230\u4e86\u8eab\u4e3a\u540c\u7c7b\u7684\u72b6\u51b5\uff0c\u6ca1\u6709\u4e00\u4e1d\u72b9\u8c6b\u5c31\u8fc7\u53bb\u63a5\u8fc7\u5979\u624b\u4e0a\u7684\u6570\u636e\u677f\u3002</p> <p>\u610f\u8bc6\u6726\u80e7\u95f4\uff0c\u674e\u7ec7\u70df\u4f3c\u4e4e\u770b\u89c1\u4f69\u4e3d\u5361\u5411\u7ba1\u7406\u5458\u793a\u610f\uff0c\u7ba1\u7406\u5458\u5fc3\u91cc\u795e\u4f1a\uff0c\u8c03\u51fa\u4fbf\u643a\u7ec8\u7aef\u7ed9\u51fa\u4efb\u52a1\u7684\u9648\u5343\u8bed\u53d1\u4fe1\u606f\u8ba9\u5979\u56de\u6765\u4e00\u4e0b\u3002</p> <p>\u53c8\u4f3c\u4e4e\u5728\u4e0b\u4e00\u79d2\uff0c\u5979\u9053\u8c22\u4e00\u58f0\u4e0e\u7ba1\u7406\u5458\u548c\u4f69\u4e3d\u5361\u544a\u522b\u540e\uff0c\u786c\u751f\u751f\u63e1\u7d27\u62f3\u5934\u632a\u56de\u5728\u7ec8\u672b\u5730\u5e1d\u6c5f\u53f7\u4e0a\u7684\u5bbf\u820d\u3002</p> <p>\u5173\u4e0a\u95e8\u540e\uff0c\u623f\u95f4\u9ed1\u4e86\u4e0b\u6765\uff0c\u987e\u4e0d\u4e0a\u5f00\u706f\uff0c\u672c\u5c31\u9002\u5e94\u9ed1\u6697\u7684\u5c0f\u9e1f\u78d5\u78d5\u7eca\u7eca\u5730\u5f80\u5e8a\u8fb9\u8d70\uff0c\u6392\u5375\u671f\u7684\u70ed\u6d6a\u4fc3\u4f7f\u5979\u5c06\u8eab\u4e0a\u7684\u8863\u670d\u8131\u4e0b\u6765\uff0c\u71e5\u70ed\u50ac\u52a8\u7740\u5979\u5c06\u8863\u670d\u968f\u610f\u6254\u5728\u4e00\u65c1\u3002</p> <p>\u5979\u6b32\u60f3\u538b\u4e0b\u8fd9\u80a1\u80c0\u75db\u611f\uff0c\u53ef\u4f9d\u65e7\u65e0\u679c\uff0c\u8eab\u4e0b\u5374\u7ecf\u4e0d\u4f4f\u6d41\u51fa\u6db2\u4f53\uff0c\u7a74\u91cc\u7684\u6db2\u4f53\u987a\u7740\u91cd\u529b\u6ed1\u4e0b\u53bb\uff0c\u8fd9\u4ee4\u5979\u4e0d\u592a\u597d\u53d7\u3002</p> <p>\u5979\u4ecd\u7136\u5598\u7740\u7c97\u6c14\uff0c\u575a\u4fe1\u81ea\u5df1\u7684\u6bc5\u529b\u80fd\u7f13\u89e3\u4e0d\u9002\uff0c\u611f\u77e5\u4eff\u4f5b\u88ab\u8499\u4e0a\u4e00\u5c42\u7eb1\uff0c\u5979\u5f00\u59cb\u8f6c\u79fb\u6ce8\u610f\uff0c\u8bd5\u56fe\u5c06\u81ea\u5df1\u7684\u611f\u77e5\u653e\u5728\u623f\u95f4\u95e8\u5916\u7684\u58f0\u97f3\u3002</p> <p>\u4e0d\u4e45\u540e\uff0c\u5979\u542c\u89c1\u5916\u9762\u6025\u5fd9\u7684\u811a\u6b65\u58f0\uff0c\u8033\u7fbd\u5fae\u5fae\u6296\u4e86\u6296\u3002\u674e\u7ec7\u70df\u6b64\u523b\u4ecd\u8dea\u5728\u5e8a\u8fb9\uff0c\u624b\u6276\u7740\u5e8a\u6cbf\uff0c\u542c\u95fb\u95e8\u88ab\u6572\u52a8\u77ac\u95f4\u4e00\u9707\uff0c\u8179\u90e8\u7684\u80c0\u75db\u5374\u8ba9\u5979\u65e0\u6687\u601d\u8003\u8be5\u600e\u4e48\u56de\u5e94\u6765\u4eba\u7684\u5bfb\u8bbf\u3002</p> <p>\u5c31\u5728\u5979\u542f\u9f7f\u7684\u7247\u523b\uff0c\u95e8\u88ab\u91cd\u91cd\u63a8\u5f00\uff0c\u5c0f\u9e1f\u88ab\u8fd9\u58f0\u54cd\u60ca\u5f97\u8033\u7fbd\u70b8\u4e86\u8d77\u6765\uff0c\u968f\u540e\u8b66\u60d5\u77a5\u4e86\u4e00\u773c\u2014\u2014\u662f\u9648\u5343\u8bed\u2014\u2014\u7d27\u7ef7\u7684\u8eab\u4f53\u6162\u6162\u653e\u677e\uff0c\u8033\u7fbd\u4e5f\u6162\u6162\u8037\u62c9\u4e0b\u6765\u3002</p> <p>\u9648\u5343\u8bed\u89c2\u5bdf\u7740\u6697\u9ed1\u7684\u623f\u95f4\uff0c\u7a97\u5e18\u88ab\u523b\u610f\u62c9\u8d77\u6765\uff0c\u8863\u670d\u88ab\u968f\u610f\u6254\u5728\u5e8a\u4e0a\uff0c\u773c\u795e\u6536\u56de\u4e8e\u5c0f\u9e1f\uff0c\u4f3c\u4e4e\u662f\u611f\u77e5\u5230\u4e86\u707c\u70ed\u7684\u89c6\u7ebf\uff0c\u674e\u7ec7\u70df\u968f\u5373\u5c06\u5934\u57cb\u8fdb\u5e8a\u8fb9\u7684\u88ab\u5b50\u91cc\uff0c\u53ea\u9732\u51fa\u98a4\u6296\u7684\u80a9\u8180\uff0c\u9ed1\u6697\u4e2d\u80fd\u542c\u5230\u538b\u6291\u7684\u3001\u7c7b\u4f3c\u541e\u54bd\u7684\u8f7b\u54cd\uff0c\u95f7\u54fc\u4e00\u58f0\u201c\u9501\u95e8..\u8fc7\u6765\u201d</p> <p>\u9648\u5343\u8bed\u614c\u4e86\u795e\uff0c\u6025\u5fd9\u53cd\u624b\u5c06\u623f\u95f4\u95e8\u9501\u6263\u4e0a\uff0c\u8d76\u5230\u5c0f\u9e1f\u8eab\u65c1\uff0c\u62c5\u5fc3\u7684\u624b\u6276\u4e0a\u80a9\u8180\uff0c\u5f00\u53e3\u8be2\u95ee\u201c\u674e\u7ec7\u70df\uff01\u4f60\u600e\u4e48\u4e86\u201d</p> <p>\u674e\u7ec7\u70df\u6b64\u523b\u5168\u8eab\u53d1\u70eb\uff0c\u80a9\u8180\u4f20\u6765\u51b0\u51c9\u7684\u89e6\u611f\uff0c\u5979\u624d\u6162\u6162\u5403\u529b\u62ac\u8d77\u5934\u6765\uff0c\u773c\u775b\u91cc\u6ee1\u662f\u6e7f\u6da6\uff0c\u9762\u8272\u67d3\u4e0a\u7eef\u7ea2\u3002\u9648\u5343\u8bed\u54ea\u89c1\u8fc7\u8fd9\u573a\u9762\uff0c\u4e0b\u610f\u8bc6\u54bd\u4e86\u53e3\u6c34\u2014\u2014</p> <p>\u201c\u5514....\u6211..\u4ea7\u5375\u671f\u5230\u4e86......\u201d</p> <p>\u611f\u5230\u71e5\u70ed\u53c8\u6d8c\u4e86\u4e0a\u6765\uff0c\u5979\u5598\u4e86\u597d\u51e0\u58f0\uff0c\u624d\u65ad\u65ad\u7eed\u7eed\u5730\u5f00\u53e3\uff1a\u201c\u597d\u70ed......\u5514\u55ef.....\u597d..\u96be\u53d7.......\u5e2e\u6211..\u201d</p> <p>\u9648\u5343\u8bed\u7684\u624b\u5728\u53d1\u6296\uff0c\u9976\u662f\u8fd9\u79cd\u7279\u6b8a\u65f6\u671f\uff0c\u5979\u53c8\u4e0d\u613f\u5728\u674e\u7ec7\u70df\u56e0\u4e3a\u79cd\u65cf\u800c\u6beb\u65e0\u9632\u5907\u7684\u65f6\u5019...\u55ef.....\u8111\u4e2d\u4e71\u60f3\u7684\u65f6\u9699\u8eab\u5b50\u5df2\u7ecf\u9760\u8fc7\u53bb\u4e86\uff0c\u5979\u4ece\u674e\u7ec7\u70df\u540e\u80cc\u8f7b\u8f7b\u73af\u62b1\u4f4f\u5979\uff0c\u56de\u5fc6\u8d77\u4e4b\u524d\u79cd\u65cf\u751f\u7406\u8bfe\u6240\u8bb2\uff0c\u624b\u4f38\u8fdb\u674e\u7ec7\u70df\u5df2\u7ecf\u8131\u7684\u5dee\u4e0d\u591a\u7684\u8863\u670d\u4e2d\uff0c\u8eab\u540e\u7684\u5c3e\u5df4\u7126\u6025\u7684\u62cd\u7529\u7740\u5730\u677f\u3002</p> <p>\u6307\u5c16\u89e6\u78b0\u5230\u53d1\u70eb\u7684\u5c0f\u8179\u65f6\uff0c\u5979\u4e0b\u610f\u8bc6\u6536\u624b\u8d77\u6765\u3002\u56de\u8fc7\u795e\u6765\uff0c\u624b\u6307\u7ee7\u7eed\u5f80\u4e0b\u63a2\uff0c\u6700\u7ec8\u89e6\u78b0\u5230\u90a3\u5904\u5df2\u7ecf\u6e7f\u900f\u7684\u7f1d\u9699\u2014\u2014\u5c0f\u9e1f\u4e0b\u9762\u5df2\u7ecf\u6e7f\u5f97\u6e83\u4e0d\u6210\u519b\u4e86\u3002</p> <p>\u9648\u5343\u8bed\u6307\u8179\u521a\u78b0\u4e86\u78b0\uff0c\u674e\u7ec7\u70df\u6574\u4e2a\u4eba\u4eff\u4f5b\u88ab\u7535\u6d41\u51fb\u4e2d\uff0c\u5979\u6025\u4fc3\u5730\u5598\u606f\u4e86\u4e00\u58f0\u3002\u9648\u5343\u8bed\u54ac\u7740\u4e0b\u5507\uff0c\u5fc3\u91cc\u52aa\u529b\u6b62\u4f4f\u522b\u7684\u60f3\u6cd5\uff0c\u4e2d\u6307\u5c0f\u5fc3\u7ffc\u7ffc\u5730\u63a2\u5165\u3002\u9ece\u535a\u5229\u4e3a\u4e86\u9002\u5e94\u4ea7\u5375\u800c\u4e0d\u81ea\u89c9\u95f4\u5206\u6ccc\u6ed1\u817b\u7684\u6db2\u4f53\uff0c\u6b64\u523b\u900f\u660e\u7684\u6db2\u4f53\u987a\u7740\u624b\u6307\u6d8c\u51fa\u6765\uff0c\u53d1\u51fa\u7ec6\u5fae\u7684\u6c34\u58f0\u3002</p> <p>\u674e\u7ec7\u70df\u88ab\u8fdb\u5165\u7684\u77ac\u95f4\u8fd8\u662f\u6709\u4e9b\u96be\u53d7\uff0c\u4f46\u5f88\u5feb\u8f6c\u5316\u6210\u4e86\u4e00\u79cd\u4ee4\u5979\u5934\u76ae\u53d1\u9ebb\u7684\u5feb\u611f\uff0c\u5979\u4e0d\u7981\u5438\u4e86\u4e00\u53e3\u6c14\u3002</p> <p>\u9648\u5343\u8bed\u5fc3\u91cc\u611f\u53f9\u5230\u624b\u6307\u5728\u63a2\u8fdb\u53bb\u6ca1\u8fc7\u591a\u4e45\u5c31\u88ab\u5185\u58c1\u541e\u8fdb\u53bb\uff0c\u6bcf\u4e00\u5bf8\u5730\u63a8\u8fdb\u90fd\u8ba9\u5c0f\u9e1f\u53d1\u51fa\u7834\u788e\u7684\u5598\u606f\u3002</p> <p>\u9648\u5343\u8bed\u663e\u7136\u542c\u5230\u4e86\u6000\u91cc\u5c0f\u9e1f\u7684\u52a8\u9759\uff0c\u5979\u987f\u4e86\u987f\uff0c\u8010\u5fc3\u5730\u8be2\u95ee\uff1a\u201c\u7ec7\u70df...\u73b0\u5728\u611f\u89c9\u600e\u4e48\u6837\u201d\u8eab\u540e\u5f97\u9752\u9f99\u5c3e\u6b62\u4e0d\u4f4f\u5730\u5708\u7740\u5c0f\u9e1f\u7684\u5927\u817f\uff0c\u5c3e\u7aef\u7ed2\u6bdb\u626b\u7740\u674e\u7ec7\u70df\u7684\u5927\u817f\u5185\u4fa7\u3002</p> <p>\u674e\u7ec7\u70df\u8033\u7fbd\u5fcd\u4e0d\u4f4f\u6296\u4e86\u6296\uff0c\u7ed2\u6bdb\u6fc0\u8d77\u4e86\u5979\u4e00\u9635\u7ec6\u5bc6\u7684\u98a4\u6817\u201c\u5443...\u4f60\u7684\u5c3e\u5df4......\u75d2.....\u55ef.....\u8fd8\u662f\u597d\u6da8...\u518d.....\u518d\u5f80\u91cc\u4e00\u70b9...\u201d</p> <p>\u9648\u5343\u8bed\u95fb\u8a00\uff0c\u4e00\u624b\u6478\u7d22\u7740\u674e\u7ec7\u70df\u5c0f\u8179\u80c0\u8d77\u7684\u5730\u65b9\uff0c\u8f7b\u8f7b\u5c06\u5375\u5f80\u4e0b\u63a8\uff0c\u4e00\u624b\u5728\u7a74\u91cc\u6269\u5f20\u4ee5\u65b9\u4fbf\u6324\u5375\u51fa\u6765\u3002</p> <p>\u826f\u4e45\uff0c\u5375\u603b\u7b97\u662f\u88ab\u538b\u51fa\u5bab\u53e3\uff0c\u75db\u7684\u674e\u7ec7\u70df\u95f7\u54fc\u4e00\u58f0\uff0c\u6307\u5c16\u6390\u8fdb\u88ab\u5355\u3002\u9648\u5343\u8bed\u5f00\u59cb\u7f13\u6162\u5730\u79fb\u52a8\uff0c\u6307\u5c16\u7f13\u6162\u7684\u78be\u8fc7\u90a3\u4e9b\u654f\u611f\u70b9\u3002</p> <p>\u987a\u52bf\uff0c\u674e\u7ec7\u70df\u54ac\u7d27\u4e0b\u5507\uff0c\u4e0d\u613f\u900f\u9732\u51fa\u66f4\u591a\u7684\u547b\u541f\u3002\u9648\u5343\u8bed\u8f7b\u8f7b\u54ac\u7740\u84ec\u677e\u7684\u8033\u7fbd\uff1a\u201c\u597d\u4e9b\u4e86\u5417?\u201d</p> <p>\u201c\u55ef......\u201d\u674e\u7ec7\u70df\u7684\u58f0\u97f3\u95f7\u5728\u88ab\u63c9\u4e71\u7684\u88ab\u5b50\u91cc\uff0c\u58f0\u97f3\u7c98\u817b\u5730\u4eff\u4f5b\u662f\u5f88\u4e45\u524d\u5979\u4eec\u4e00\u8d77\u53bb\u4e70\u7684\u7c73\u7cd5\u3002\u201c.......\u53c8\u6709\u70b9\u75bc......\u55ef.....\u611f\u89c9\u5f88\u80c0...\u8fd8\u6ca1\u5b8c\u5168\u51fa\u6765...\u201d\u5979\u7684\u624b\u6307\u5728\u5e8a\u6cbf\u6293\u4e86\u53c8\u677e\uff0c\u90a3\u70b9\u5feb\u611f\u4e00\u76f4\u540a\u5728\u90a3\u91cc\uff0c\u4e0a\u4e0d\u53bb\u4e5f\u4e0b\u4e0d\u6765\u3002</p> <p>\u9648\u5343\u8bed\u7684\u624b\u6307\u62b5\u4f4f\u4e86\u90a3\u9897\u5375\u7684\u8fb9\u7f18\uff0c\u8bd5\u56fe\u52a0\u5feb\u4e00\u4e0b\u6392\u5375\u7684\u901f\u5ea6\u3002\u6000\u91cc\u7684\u9ece\u535a\u5229\u95f7\u54fc\u4e00\u58f0\uff0c\u6574\u4e2a\u4eba\u7ef7\u7d27\u4e86\uff0c\u7259\u9f7f\u54ac\u5f97\u66f4\u6df1\u4e86\u4e00\u70b9\u3002</p> <p>\u201c\u55ef.....\u51fa\u4e0d\u6765.....\u201d\u5979\u7684\u58f0\u97f3\u5e26\u7740\u54ed\u8154\uff0c\u54fc\u54fc\u5527\u5527\u7684\u97f3\u8272\u4f7f\u672a\u89c1\u8fc7\u8fd9\u573a\u9762\u7684\u5c0f\u9f99\u60ca\u8be7\u4e86\u4e00\u4f1a\u2014\u2014\u8111\u91cc\u5168\u662f\u5c0f\u9e1f\u7684\u547b\u541f\uff0c\u5a07\u5598\u6e10\u6e10\u53d8\u6210\u4e00\u9635\u6025\u4fc3\u7684\u5598\u606f\u3002</p> <p>\u9648\u5343\u8bed\u7684\u6307\u5c16\u9876\u4f4f\u90a3\u9897\u5375\uff0c\u914d\u5408\u7740\u53e6\u4e00\u53ea\u624b\u638c\u6839\u4e0b\u538b\u7684\u529b\u5ea6\uff0c\u7528\u529b\u5f80\u4e0b\u63a8\u4e86\u4e00\u4e0b\u3002\u6b64\u523b\u5c0f\u9e1f\u4ece\u5589\u5499\u6df1\u5904\u95f7\u51fa\u4e00\u58f0\u957f\u957f\u7684\u3001\u5e26\u7740\u60c5\u6b32\u7684\u547b\u541f\uff0c\u6574\u4e2a\u4eba\u5728\u5c0f\u9f99\u6000\u91cc\u7ef7\u6210\u4e86\u4e00\u5f20\u5f13\u3002</p> <p>\u7ecf\u8fc7\u6f2b\u957f\u7684\u714e\u71ac\uff0c\u5168\u90e8\u7684\u5375\u7ec8\u4e8e\u6ed1\u51fa\u6765\uff0c\u9648\u5343\u8bed\u4e0a\u624b\u63a5\u7740\uff0c\u638c\u5fc3\u6df7\u7740\u4f53\u6db2\uff0c\u53e6\u5916\u4e9b\u7684\u7a74\u6c34\u6cbf\u7740\u6d01\u767d\u7684\u817f\u4e00\u70b9\u70b9\u5f80\u4e0b\u5760\uff0c\u8eab\u4e0b\u5df2\u79ef\u4e86\u4e00\u6ee9\u6c6a\u6c34\u3002</p> <p>\u674e\u7ec7\u70df\u7684\u8eab\u4f53\u5728\u90a3\u4e00\u77ac\u95f4\u5168\u90e8\u677e\u5f00\u4e86\uff0c\u50cf\u4e00\u6839\u88ab\u62c9\u6ee1\u4e86\u7684\u5f26\u7a81\u7136\u65ad\u4e86\uff0c\u62ac\u8d77\u5934\u6765\u5927\u53e3\u5927\u53e3\u5730\u5598\u6c14\uff0c\u5634\u8fb9\u6302\u7740\u8fd8\u672a\u6765\u5f97\u53ca\u54bd\u4e0b\u53bb\u7684\u53e3\u6c34\u3002</p> <p>\u9648\u5343\u8bed\u8d77\u8eab\u8f7b\u8f7b\u5c06\u5375\u653e\u5728\u5e8a\u5934\u7684\u7eb8\u5dfe\u4e0a\uff0c\u56de\u5934\u7528\u529b\u62c9\u8d77\u6392\u5375\u540e\u4e4f\u529b\u7684\u5c0f\u9e1f\uff0c\u5c06\u5979\u62b1\u4e0a\u5e8a\u4e0a\uff0c\u968f\u540e\u51fa\u4e8e\u79c1\u5fc3\u4eb2\u4e86\u4eb2\u8033\u7fbd\u201c\u7ec7\u70df\u4f60\u8eba\u4e00\u4f1a\u6211\u53bb\u627e\u6c34\u201d\u8fd9\u65f6\u9648\u5343\u8bed\u624d\u53d1\u89c9\u5979\u7684\u58f0\u97f3\u4e5f\u54d1\u5f97\u4e0d\u6210\u6837\uff0c\u8bed\u672b\u4fbf\u6025\u51b2\u51fa\u4e86\u623f\u95f4\u3002</p> <p>\u95e8\u88ab\u8f7b\u8f7b\u63a9\u4e0a\u540e\uff0c\u674e\u7ec7\u70df\u95ed\u7740\u773c\u775b\uff0c\u773c\u89d2\u5c3d\u662f\u8273\u4e3d\u5f97\u7ea2\u6da6\uff0c\u5979\u7684\u776b\u6bdb\u8fd8\u5728\u6296\uff0c\u8033\u7fbd\u5148\u4e00\u6b65\u677e\u4e86\u4e0b\u6765\u3002</p> <p>\u5c0f\u9e1f\u6df1\u547c\u5438\u7f13\u7740\uff0c\u5728\u77ed\u6682\u7684\u95f2\u6687\u4e2d\u7adf\u6709\u4e1d\u5e86\u5e78\u521a\u521a\u81ea\u5df1\u5931\u63a7\u7684\u795e\u8272\u85cf\u533f\u5728\u88ab\u5b50\u91cc\uff0c\u7ec6\u7ec6\u56de\u60f3\u7740\u521a\u521a\u7684\u4e8b\u60c5\u540e\u8138\u8bda\u5b9e\u5730\u62b9\u4e0a\u7eef\u7ea2\u3002</p> <p>\u5c0f\u9f99\u7aef\u6765\u4e86\u6c34\u540e\uff0c\u674e\u7ec7\u70df\u8d77\u8eab\u6b32\u60f3\u63a5\u8fc7\u6c34\u676f\u559d\uff0c\u521a\u63e1\u4e0a\u676f\u8eab\uff0c\u676f\u5b50\u5374\u4ece\u4e4f\u529b\u7684\u624b\u4e2d\u5f80\u4e0b\u5760\uff0c\u6c34\u676f\u5f7b\u5e95\u6ed1\u4e0b\u4e4b\u9645\u88ab\u9648\u5343\u8bed\u63a5\u4f4f\uff0c\u201c\u8fd8\u662f\u592a\u4e3a\u96be\u4f60\u4e86\uff0c\u6211\u6765\u5427\u201d</p> <p>\u674e\u7ec7\u70df\u6b32\u60f3\u5f00\u53e3\u5374\u8fdf\u8fdf\u6ca1\u6709\u53d1\u51fa\u58f0\u97f3\uff0c\u5979\u7684\u7738\u4e2d\u67d0\u4e9b\u60c5\u7eea\u7ffb\u6d8c\uff0c\u5374\u7ec8\u662f\u95ed\u4e86\u95ed\u773c\uff0c\u5589\u5499\u4e0a\u4e0b\u6ed1\u52a8\u4e86\u4e24\u4e0b\u3002\u518d\u7741\u773c\u65f6\uff0c\u53c8\u6062\u590d\u4e86\u4e00\u5982\u65e2\u5f80\u7684\u5e73\u9759\u3002</p> <p>\u5979\u5b9e\u5728\u592a\u7d2f\u4e86\uff0c\u7ecf\u5386\u4e86\u8bb8\u4e45\u7684\u51fa\u52e4\u4efb\u52a1\u548c\u6392\u5375\u7684\u4e8b\u540e\uff0c\u5373\u4f7f\u662f\u5e94\u9f99\u7279\u52e4\u961f\u961f\u957f\uff0c\u4e5f\u6709\u9700\u8981\u522b\u4eba\u7167\u987e\u7684\u65f6\u5019\u5440\u3002</p> <p>\u559d\u8fc7\u6c34\u540e\uff0c\u5c0f\u9f99\u79ef\u6781\u5730\u62b1\u8d77\u5c0f\u9e1f\u53bb\u6d17\u6fa1\u3002\u6d74\u5ba4\u91cc\uff0c\u4e24\u4eba\u5766\u8bda\u76f8\u5f85\u2014\u2014\u5728\u9648\u5343\u8bed\u7ed9\u5979\u6d17\u6fa1\u7684\u65f6\u5019\uff0c\u5979\u4e0d\u7ecf\u56de\u60f3\u5728\u8fd9\u4e4b\u524d\u53d1\u751f\u7684\u4e8b\u3002</p> <p>\u8bdd\u8bf4\u56de\u6765\uff0c\u9648\u5343\u8bed\u4e0d\u662f\u6709\u4efb\u52a1\u561b\uff0c\u600e\u4e48\u4f1a\u77e5\u9053.....</p> <p>\u674e\u7ec7\u70df\u6643\u4e86\u6643\u5934\uff0c\u8033\u7fbd\u5fae\u5fae\u6296\u7740\uff0c\u5fc3\u60f3\uff0c\u7b97\u4e86\uff0c\u4e0d\u8fc7\u4e00\u4f1a\u51fa\u58f0\u201c\u9648....\u9760\u8fc7\u6765\u201d</p> <p>\u9648\u5343\u8bed\u6123\u4e86\u4e00\u4e0b\uff0c\u8fd8\u6765\u4e0d\u53ca\u601d\u8003\u7684\u7247\u523b\uff0c\u674e\u7ec7\u70df\u53d1\u529b\u9760\u4e86\u8fc7\u6765\uff0c\u6276\u4e0a\u7740\u9648\u5343\u8bed\u7684\u8138\uff0c\u76ee\u5149\u626b\u8fc7\u5979\u6cdb\u7740\u7ea2\u610f\u7684\u5507\u74e3\uff0c\u5fc3\u5934\u4e00\u70ed\uff0c\u6ca1\u5fcd\u4f4f\u4fbf\u6df1\u6df1\u543b\u4e86\u4e0a\u53bb\uff0c\u820c\u5934\u7f20\u5728\u4e00\u8d77\uff0c\u5634\u89d2\u6d41\u7740\u672a\u6536\u5f97\u4f4f\u7684\u6db2\u4f53\u3002</p> <p>\u201c\u5514.....\u55ef............\u201d</p> <p>\u5c0f\u9e1f\u52b3\u7d2f\u540e\u7684\u8eab\u4f53\u7ecf\u4e0d\u4f4f\u957f\u65f6\u95f4\u7684\u6df1\u543b\uff0c\u4e8e\u662f\u7387\u5148\u63a8\u5f00\u5bf9\u65b9\uff0c\u9648\u5343\u8bed\u611f\u89c9\u5979\u5728\u505a\u68a6\uff0c\u867d\u7136\u4e0d\u60f3\u627f\u8ba4\u4f46\u5979\u7684\u8138\u988a\u67d3\u4e0a\u6de1\u6de1\u7ea2\u6655\u3002</p> <p>\u201c\u4f60\u8fd9.....\u72af\u89c4...\u5443...\u201d</p> <p>\u6ca1\u7b49\u9648\u5343\u8bed\u8bf4\u5b8c\uff0c\u674e\u7ec7\u70df\u4e00\u628a\u63fd\u4f4f\u5979\u7684\u8170\uff0c\u529b\u9053\u5e26\u7740\u67d0\u79cd\u6025\u5207\u3001\u5c06\u5979\u6b7b\u6b7b\u6263\u5728\u6000\u91cc\uff0c\u4f4e\u54d1\u7684\u58f0\u97f3\u4ece\u8033\u8fb9\u4f20\u6765\uff1a\u201c\u522b\u52a8\u3001\u5c31\u8ba9\u6211\u62b1\u4e00\u4f1a\u513f\u201d</p> <p>2945\u2014\u2014\u2014\u2014End.</p>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/","title":"Markdown \u5e38\u7528\u8bed\u6cd5\u901f\u67e5","text":"<p>\u5199\u6587\u7ae0\u53ea\u9700\u8981\u8bb0\u4f4f\u4e0b\u9762\u8fd9\u51e0\u6761\uff0c\u5269\u4e0b\u7684\u53ef\u4ee5\u968f\u65f6\u56de\u6765\u67e5\u3002</p>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_1","title":"\u6807\u9898","text":"<pre><code># \u4e00\u7ea7\u6807\u9898\n## \u4e8c\u7ea7\u6807\u9898\n### \u4e09\u7ea7\u6807\u9898\n</code></pre>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_2","title":"\u5f3a\u8c03","text":"<pre><code>**\u52a0\u7c97**\n*\u659c\u4f53*\n~~\u5220\u9664\u7ebf~~\n</code></pre>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_3","title":"\u5217\u8868","text":"<pre><code>- \u65e0\u5e8f\u5217\u8868\n- \u7b2c\u4e8c\u9879\n\n1. \u6709\u5e8f\u5217\u8868\n2. \u7b2c\u4e8c\u9879\n</code></pre>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_4","title":"\u94fe\u63a5\u4e0e\u56fe\u7247","text":"<pre><code>[\u70b9\u6211\u8df3\u8f6c](https://example.com)\n\n![\u56fe\u7247\u8bf4\u660e](../../assets/example.png)\n</code></pre> <p>\u56fe\u7247\u653e\u5728 <code>docs/assets/</code> \u91cc\uff0c\u7136\u540e\u5728\u6587\u7ae0\u91cc\u5199\u76f8\u5bf9\u8def\u5f84\u5f15\u7528\u3002\u8def\u5f84\u4e00\u5b9a\u8981\u4ee5 <code>../../assets/</code> \u5f00\u5934\uff08\u56e0\u4e3a\u6587\u7ae0\u5728 <code>docs/blog/posts/</code> \u8fd9\u4e00\u5c42\uff09\u3002</p>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_5","title":"\u8868\u683c","text":"<pre><code>| \u9879\u76ee | \u8bf4\u660e |\n| --- | --- |\n| \u540d\u5b57 | \u968f\u4fbf\u5199 |\n</code></pre> <p>\u6548\u679c\uff1a</p> \u9879\u76ee \u8bf4\u660e \u540d\u5b57 \u968f\u4fbf\u5199 \u65e5\u671f 2026-11-24"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_6","title":"\u63d0\u793a\u6846","text":"<pre><code>!!! note \"\u6807\u9898\"\n    \u8fd9\u91cc\u5199\u5185\u5bb9\uff0c\u6ce8\u610f\u8981\u7f29\u8fdb 4 \u4e2a\u7a7a\u683c\u3002\n</code></pre> <p>\u6548\u679c\uff1a</p> <p>\u6807\u9898</p> <p>\u8fd9\u91cc\u5199\u5185\u5bb9\uff0c\u6ce8\u610f\u8981\u7f29\u8fdb 4 \u4e2a\u7a7a\u683c\u3002</p>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_7","title":"\u4ee3\u7801\u5757","text":"<p>\u7528\u4e09\u4e2a\u53cd\u5f15\u53f7\u5305\u8d77\u6765\uff0c\u540e\u9762\u5199\u8bed\u8a00\u540d\uff1a</p> <pre><code>```python\nprint(\"hello\")\n```\n</code></pre>"},{"location":"blog/2026/11/24/markdown-%E5%B8%B8%E7%94%A8%E8%AF%AD%E6%B3%95%E9%80%9F%E6%9F%A5/#_8","title":"\u6587\u7ae0\u5f00\u5934\u7684\u65e5\u671f","text":"<p>\u6bcf\u7bc7\u6587\u7ae0\u6700\u4e0a\u9762\u90a3\u6bb5\u7528 <code>---</code> \u5305\u8d77\u6765\u7684\u4e1c\u897f\u53eb front matter\uff0c\u662f\u7ed9\u7f51\u7ad9\u770b\u7684\uff1a</p> <pre><code>---\ndate: 2026-11-24\ncategories:\n  - \u968f\u7b14\n---\n</code></pre> <p><code>date</code> \u51b3\u5b9a\u5b83\u5728\u6587\u7ae0\u5217\u8868\u91cc\u7684\u6392\u5e8f\uff0c\u522b\u6f0f\u3002</p>"},{"location":"blog/2026/07/29/%E8%AE%BA%E5%89%91/","title":"\u8bba\u5251","text":"<p>#\u00a0\u9f99\u9e1f\u9f99\u65e0\u5dee\u2003#\u00a0\u542b\u4e00\u4e9b\u81ea\u5df1\u634f\u9020\u7684\u7406\u89e3</p> <p>\u5728\u90a3\u573a\u5c01\u5370\u751a\u5927\u88c2\u9699\u7684\u5317\u90e8\u7981\u533a\u884c\u52a8\u540e\uff0c\u9648\u5343\u8bed\u548c\u674e\u7ec7\u70df\u7684\u5173\u7cfb\u4f3c\u4e4e\u53d1\u751f\u4e86\u5fae\u5999\u7684\u53d8\u5316\u3002\u867d\u7136\u8868\u9762\u4e0a\u5979\u4eec\u4f9d\u65e7\u662f\u65e7\u76f8\u8bc6\uff0c\u4f46\u5f7c\u6b64\u4e4b\u95f4\u7684\u9ed8\u5951\u548c\u5fc3\u60c5\u5df2\u7ecf\u4e0d\u518d\u50cf\u5148\u524d\u90a3\u822c\u7b80\u5355\u3002</p> <p>\u8be5\u8bf4\u4e0d\u8bf4\u662f\u5f80\u65e5\u79cd\u79cd\u561b\uff08</p> <p>\u9648\u5343\u8bed\u5f00\u59cb\u66f4\u591a\u5730\u5173\u6ce8\u674e\u7ec7\u70df\u7684\u6bcf\u4e2a\u52a8\u4f5c\u548c\u6bcf\u4e2a\u8868\u60c5\uff0c\u4ece\u4e00\u5f00\u59cb\u4e0e\u5e94\u9f99\u7279\u52e4\u961f\u961f\u957f\u8bc0\u78b0\u9762\u65f6\u7684\u522b\u626d\u8f6c\u800c\u70ed\u5ff1\uff0c\u800c\u674e\u7ec7\u70df\u4e5f\u4e0d\u518d\u50cf\u4ee5\u524d\u90a3\u6837\u51b7\u9759\u548c\u6de1\u7136\uff0c\u67d0\u79cd\u9690\u5f62\u7684\u9694\u9602\u5728\u5979\u4eec\u95f4\u6084\u7136\u6d88\u5931\u3002</p> <p>\u4f46.....\u5148\u524d\u7684\u5435\u67b6...\u5b9e\u9645\u4e0a\u5230\u73b0\u5728\u4e5f\u8fd8\u662f\u5435\u67b6\uff0c\u867d\u7136\u674e\u7ec7\u70df\u5355\u65b9\u9762\u5426\u8ba4\u4e86\u3002</p> <p>\u4e5f\u81ea\u4ece\u5979\u7684\u4efb\u52a1\u7ed3\u675f\u540e\uff0c\u674e\u7ec7\u70df\u624d\u5f97\u4ee5\u62bd\u51fa\u65f6\u95f4\u8eb2\u5728\u67d0\u5904\u6253\u78e8\u9648\u5343\u8bed\u5728\u4e0e\u7afa\u8001\u5e08\u5bf9\u6253\u65f6\u9012\u7ed9\u5979\u7684\u5251\u3002</p> <p>\u8bdd\u8bf4\u56de\u6765\uff0c\u5251\u4fdd\u5b58\u7684\u5f88\u597d\uff0c\u4ed4\u7ec6\u770b\u5f97\u51fa\u6765\u9648\u5343\u8bed\u5bf9\u8fd9\u628a\u5251\u4e5f\u517b\u62a4\u7684\u5f88\u7cbe\u5fc3\u3002\u800c\u5251\u786e\u5b9e\u662f\u5979\u7684\uff0c\u53ea\u4e0d\u8fc7\u5728\u9648\u5343\u8bed\u79bb\u5f00\u6b66\u9675\u7684\u65f6\u5019\u5c31\u4ea4\u4ed8\u7ed9\u5979\u4e86\uff0c\u90a3\u65f6\u5c06\u81ea\u5df1\u7684\u5251\u6258\u4ed8\u7ed9\u9648\u5343\u8bed\u81ea\u59cb\u81f3\u7ec8\u662f\u51fa\u4e8e\u5979\u81ea\u5df1\u7684\u79c1\u5fc3\u3002</p> <p>\u5f85\u4efb\u804c\u5e94\u9f99\u7279\u52e4\u961f\u961f\u957f\u548c\u9648\u5343\u8bed\u79bb\u5f00\u6b66\u9675\u4e4b\u540e\uff0c\u4f9d\u7136\u6709\u4e0d\u5c11\u961f\u5458\u524d\u6765\u4e0e\u65b0\u664b\u961f\u957f\u5207\u78cb\uff0c\u7518\u62dc\u4e0b\u98ce\u540e\u4e5f\u8be2\u95ee\u5979\u4e3a\u4ec0\u4e48\u4e0d\u7528\u5251\u4e86\u53cd\u800c\u5f00\u59cb\u64cd\u63a7\u6d6e\u6e38\u91cd\u70ae\u3002</p> <p>\u5bf9\u6b64\u674e\u7ec7\u70df\u4e00\u4f17\u56de\u7b54\u8bf4\u201c\u5251....\u5443.....\u4e0d\u5c0f\u5fc3\u5f04\u4e22\u4e86\u201d\u601d\u8003\u7247\u523b\u540e\u7ee7\u7eed\u8865\u4e0a\u201c...\u518d\u8bf4\u4e86\uff0c\u7528\u6d6e\u6e38\u91cd\u70ae\u4e5f\u672a\u5c1d\u4e0d\u5229\u201d</p> <p>\u867d\u7136\u8bf4\u5f88\u591a\u4eba\u90fd\u5bf9\u8fd9\u6837\u7684\u56de\u7b54\u62b1\u6709\u5f88\u5927\u7591\u95ee\uff0c\u539f\u6765\u5e73\u65e5\u4e0d\u82df\u8a00\u7b11\u4e14\u7ec6\u5fc3\u4e25\u8c28\u7684\u961f\u957f\u4e5f\u6709\u7c97\u5fc3\u61c8\u6020\u7684\u4e00\u523b\u5417\u2014\u2014\u788d\u4e8e\u961f\u957f\u6267\u610f\u8fd9\u6837\u89e3\u91ca\uff0c\u5e73\u65e5\u7684\u5207\u78cb\u8bd5\u70bc\u4e2d\uff0c\u8bc0\u4f9d\u7136\u51ed\u501f\u9ad8\u8d85\u7684\u6e90\u77f3\u6280\u672f\u6253\u6d88\u4e86\u8bb8\u591a\u4eba\u4ee5\u4e3a\u80fd\u6218\u80dc\u5979\u7684\u5984\u60f3\uff0c\u9a7b\u5b88\u961f\u5458\u4eec\u4e5f\u5c31\u8fd9\u6837\u534a\u4fe1\u534a\u7591\u4e86\u3002</p> <p>\u5f53\u7136\uff0c\u76f4\u5230\u73b0\u5728\u4e5f\u6709\u4e0d\u77e5\u60c5\u7684\u961f\u5458\u5bf9\u5251\u7684\u4e0b\u843d\u5230\u5904\u6253\u542c\u5f97\u4e50\u6b64\u4e0d\u75b2\uff0c\u961f\u957f\u672c\u4eba\u4e5f\u6ca1\u6709\u963b\u62e6\u5c31\u662f\u4e86\u3002</p> <p>\u674e\u7ec7\u70df\u5bf9\u8fd9\u628a\u5251\u76ef\u5f97\u51fa\u795e\uff0c\u624b\u4e0d\u7981\u629a\u6478\u7684\u540c\u65f6\u4f4e\u7738\u6df1\u601d\u7740\uff0c\u4eff\u4f5b\u671b\u7a7f\u8fd9\u628a\u5251\u80fd\u591f\u671b\u51fa\u4ec0\u4e48\u2014\u2014</p> <p>\u9648\u5343\u8bed\u79bb\u5f00\u6b66\u9675\u90a3\u5929\u4e0b\u7740\u5c0f\u96e8\uff0c\u5e76\u4e0d\u662f\u5f88\u597d\u7684\u5929\u6c14\uff0c\u8fd9\u4e5f\u4ee4\u5979\u4eec\u4e4b\u95f4\u7126\u707c\u7684\u6c1b\u56f4\u66f4\u6dfb\u4e00\u7b14\u4f4e\u6c89\u3002\u6b64\u524d\u542c\u95fb\u9648\u5343\u8bed\u88ab\u5ba3\u544a\u4ee5\u5fc3\u6027\u4e0d\u5408\u683c\u7684\u7f18\u7531\u843d\u9009\u5e94\u9f99\u7279\u52e4\u961f\u7684\u90a3\u4e00\u523b\uff0c\u674e\u7ec7\u70df\u776b\u7fbd\u8f7b\u98a4\uff0c\u7738\u5149\u5fae\u6643\u3002</p> <p>\u76f8\u8f83\u60c5\u7eea\u4f4e\u843d\u7684\u5c0f\u9f99\uff0c\u5979\u79c1\u4e0b\u662f\u77e5\u9053\u7afa\u8001\u5e08\u504f\u597d\u5979\u7684\u6027\u683c\u548c\u4e3a\u4eba\u5904\u4e16\u98ce\u683c\uff0c\u9648\u5343\u8bed\u548c\u674e\u7ec7\u70df\u5728\u5e94\u8bd5\u9009\u62d4\u5019\u8865\u91cc\u8868\u73b0\u4e5f\u90fd\u683c\u5916\u7a81\u51fa\uff0c\u90a3\u65f6\u6bcf\u4e2a\u4eba\u90fd\u4ee5\u4e3a\u5979\u4eec\u4f1a\u6210\u4e3a\u5b88\u536b\u5e94\u9f99\u5173\u7684\u642d\u6863\u3002</p> <p>\u4f46\u5f88\u9057\u61be\uff0c\u4e8b\u5b9e\u603b\u662f\u76f8\u53cd\u7684\uff0c\u6700\u4ee4\u4eba\u77a9\u76ee\u7684\u4e00\u5bf9\u77e5\u5fc3\u642d\u6863\u5374\u88ab\u5206\u5f00\u4e86\uff0c\u5e94\u9f99\u7279\u52e4\u961f\u9700\u8981\u4e25\u683c\u542c\u4ece\u547d\u4ee4\u3001\u5c06\u727a\u7272\u5217\u5728\u7b2c\u4e00\u4f4d\u7684\u4eba\u9009\uff0c\u9976\u662f\u884c\u4fa0\u4ed7\u4e49\u7684\u5c0f\u9f99\u4e5f\u5f88\u96be\u4e0d\u88ab\u843d\u9009\u3002</p> <p>\u6027\u683c\u4e5f\u6b63\u5982\u5e94\u9f99\u7279\u52e4\u961f\u5458\u5cf0\u900f\u9732\u6240\u8bf4\u5979\u4eec\u6700\u521d\u5173\u7cfb\u8fd8\u4e0d\u9519\u90a3\u822c\uff0c\u5728\u51c6\u5907\u5e94\u8bd5\u9009\u62d4\u7684\u671f\u95f4\u91cc\uff0c\u5979\u4eec\u767d\u5929\u523b\u82e6\u8bad\u7ec3\uff0c\u591c\u91cc\u540c\u5e8a\u5171\u6795\uff0c\u957f\u671f\u7684\u78e8\u5408\u4f7f\u5f97\u5979\u4eec\u9ed8\u5951\u500d\u52a0\uff0c\u5373\u4f7f\u5206\u522b\u6570\u5e74\u91cd\u65b0\u7ad9\u5728\u6218\u573a\u4e0a\uff0c\u66fe\u7ecf\u7684\u9ed8\u5951\u4e5f\u4e0d\u89c1\u892a\u8272\u3002</p> <p>\u5c0f\u9e1f\u7684\u6307\u5c16\u4ecd\u65e7\u65e0\u610f\u8bc6\u6469\u6332\u7740\u51b0\u51c9\u7684\u5251\u67c4\uff0c\u773c\u524d\u7684\u5251\u6e10\u6e10\u6a21\u7cca\uff0c\u601d\u7eea\u4e0d\u53d7\u63a7\u5236\u5730\u5f80\u540e\u98d8\u2014\u2014</p> <p>\u591c\u91cc\u7684\u98ce\u63a0\u8fc7\u6a90\u89d2\u94dc\u94c3\uff0c\u53ee\u94c3\u4e00\u54cd\uff0c\u604d\u60da\u95f4\u53c8\u770b\u89c1\u591a\u5e74\u524d\u7684\u8bad\u7ec3\u2014\u2014\u665a\u98ce\u5377\u7740\u5c18\u571f\u63a0\u8fc7\u5251\u8eab\uff0c\u674e\u7ec7\u70df\u4fa7\u8eab\u56de\u6321\u9648\u5343\u8bed\u5288\u6765\u7684\u5251\u950b\u2014\u2014\u4e24\u53ea\u63e1\u7740\u5251\u67c4\u7684\u624b\u4ed3\u4fc3\u76f8\u62b5\u7740\uff0c\u5251\u4ea4\u53c9\u5361\u5728\u4e24\u4eba\u80f8\u53e3\u95f4\uff0c\u8ddd\u79bb\u8fd1\u5f97\u80fd\u770b\u6e05\u5bf9\u65b9\u98a4\u52a8\u7684\u773c\u776b\u2014\u2014\u4e24\u4eba\u7ef4\u6301\u7740\u6301\u5251\u4e92\u62b5\u7684\u59ff\u52bf\u534a\u664c\uff0c\u8c01\u90fd\u6ca1\u6709\u8f7b\u7387\u9000\u8ba9\uff0c\u98ce\u6380\u8d77\u4e24\u4eba\u5782\u843d\u7684\u53d1\u68a2\uff0c\u8f7b\u8f7b\u7f20\u5728\u4e86\u4e00\u5904\u3002</p> <p>\u4ee5\u5f80\u5e76\u80a9\u7ec3\u5251\u7684\u6bcf\u4e00\u5e27\u753b\u9762\u5728\u8111\u6d77\u4e2d\u53cd\u590d\u56de\u653e\uff0c\u4e0d\u7ecf\u610f\u95f4\uff0c\u674e\u7ec7\u70df\u63e1\u7740\u5251\u67c4\u7684\u6307\u8282\u6084\u7136\u6536\u7d27\u3002</p> <p>\u5979\u662f\u81ea\u79c1\u7684\u5c0f\u9e1f\uff0c\u5979\u539f\u60f3\u7559\u4f4f\u9648\u5343\u8bed\u7684\u6e29\u5ea6\uff1b\u540c\u65f6\u4e5f\u662f\u65e0\u79c1\u7684\uff0c\u4e0d\u613f\u4e00\u65f6\u7684\u7f20\u7ef5\u5265\u593a\u5c0f\u9f99\u7684\u53bb\u5411\u3002</p> <p>\u5c31\u50cf\u540e\u6765\uff0c\u60c5\u7eea\u590d\u6742\u7684\u5979\u4e8e\u5fc3\u4e0d\u5fcd\u4eb2\u81ea\u9001\u522b\u9648\u5343\u8bed\uff0c\u8ba9\u5979\u63a7\u5236\u8d77\u81ea\u5df1\u7684\u79c1\u6b32\u4e8e\u5979\u800c\u8a00\u8fd8\u662f\u592a\u714e\u71ac\u4e86\uff0c\u7d22\u6027\u9009\u62e9\u5728\u79bb\u522b\u524d\u6700\u540e\u4e00\u665a\u5c06\u81ea\u5df1\u7684\u5251\u8f7b\u53e0\u5728\u9648\u5343\u8bed\u7684\u5251\u8eab\u4e0a\uff0c\u968f\u5373\u77ed\u53f9\u4e00\u58f0\u7559\u4e0b\u544a\u77e5\u7684\u7eb8\u6761\u540e\u65e9\u65e9\u5730\u524d\u5f80\u5e94\u9f99\u62a5\u9053\u3002</p> <p>\u6700\u540e\u7684\u79bb\u5f00\u524d\uff0c\u674e\u7ec7\u70df\u72b9\u8c6b\u4e86\u8bb8\u4e45\uff0c\u5728\u5fc3\u91cc\u505a\u6289\u62e9\u7684\u7247\u523b\uff0c\u5979\u7684\u8033\u7fbd\u8037\u62c9\u7740\uff0c\u671b\u7740\u80cc\u8fc7\u8eab\u8fd8\u5728\u6c89\u7720\u7684\u9648\u5343\u8bed\uff0c\u773c\u7738\u4e2d\u6620\u51fa\u96be\u8fc7\uff0c\u773c\u795e\u9eef\u7136\uff0c\u4f46\u8fd8\u662f\u54ac\u7259\u5199\u4e0b\u4e86\u5206\u522b\u7684\u7559\u8a00\u3002</p> <p>\u2014\u2014\u5251\u7559\u7ed9\u4f60\uff0c\u56de\u6765\u6b66\u9675\u7684\u8bdd\u522b\u5fd8\u4e86\u5e26\u56de\u6765.......\u8def\u4e0a\u6ce8\u610f\u5b89\u5168......</p> <p>\u53e6\u4e00\u8fb9\uff0c\u9648\u5343\u8bed\u65e9\u5df2\u611f\u89c9\u5230\u8eab\u65c1\u4f4d\u7f6e\u7684\u51f9\u9677\u53d8\u52a8\uff0c\u5979\u539f\u672c\u7f20\u4e0a\u5c0f\u9e1f\u5927\u817f\u7684\u5c3e\u5df4\u88ab\u8f7b\u8f7b\u7ed5\u5f00\u3002\u9648\u5343\u8bed\u5176\u5b9e\u9192\u4e86\uff0c\u4f46\u4e0d\u77e5\u51fa\u4e8e\u4ec0\u4e48\u5fc3\u60c5\uff0c\u4e5f\u8bb8\u4e3a\u4e86\u7167\u987e\u5c0f\u9e1f\u7684\u5c0f\u50b2\u5a07\uff0c\u5979\u4f9d\u65e7\u88c5\u7761\u7740\uff0c\u660e\u660e\u53ea\u662f\u4e00\u6b21\u5206\u522b\u5374\u8ba9\u5979\u5fc3\u7eea\u7f20\u5728\u4e00\u56e2\u3002</p> <p>\u95e8\u88ab\u8f7b\u8f7b\u63a9\u597d\uff0c\u811a\u6b65\u58f0\u6108\u53d1\u79bb\u8fdc\u540e\uff0c\u9648\u5343\u8bed\u8010\u4e0d\u4f4f\u5730\u72e0\u72e0\u7529\u4e86\u7529\u5c3e\u5df4\uff0c\u5c06\u5934\u95f7\u5728\u6795\u5934\u91cc\u4f4e\u54d1\u4f4e\u4f30\u7740\uff0c\u6b32\u54ed\u65e0\u6cea\u7684\u9057\u61be\u548c\u4e0d\u7518\u603b\u662f\u96be\u4ee5\u88ab\u54bd\u4e0b\u3002</p> <p>\u9648\u5343\u8bed\u6765\u4e86\u7ec8\u672b\u5730\u540e\u4e5f\u4e0d\u5fd8\u6253\u78e8\u90a3\u628a\u5251\uff0c\u4f69\u4e3d\u5361\u66fe\u591a\u6b21\u89c1\u5979\u62ff\u51fa\u8fd9\u628a\u5251\uff0c\u4e5f\u4e0d\u66fe\u89c1\u8fc7\u5979\u7528\u8fc7\uff0c\u5206\u660e\u4e0d\u662f\u5979\u81ea\u5df1\u7684\u3002</p> <p>\u5fc3\u601d\u7ec6\u817b\u7684\u9ece\u535a\u5229\u5e38\u5e38\u770b\u5230\u5979\u5bf9\u7740\u8fd9\u628a\u5251\u53d1\u5446\uff0c\u5176\u5b9e\u9648\u5343\u8bed\u4e5f\u4e0d\u77e5\u9053\u662f\u5426\u8fd8\u6709\u673a\u4f1a\u56de\u5230\u6b66\u9675\uff0c\u662f\u5426\u8fd8\u80fd\u89c1\u5230\u674e\u7ec7\u70df\uff0c\u5979\u5728\u7ec8\u672b\u5730\u4efb\u804c\u7684\u671f\u95f4\uff0c\u5374\u4ece\u672a\u5411\u8eab\u8fb9\u4eba\u63d0\u8fc7\u8fd9\u6bb5\u5f80\u4e8b\u3002\u4f69\u4e3d\u5361\u6ce8\u610f\u5230\u5c0f\u9f99\u7684\u96be\u4ee5\u5f00\u53e3\u7684\u96be\u5904\u4e5f\u4fbf\u6ca1\u6709\u5411\u5979\u8be2\u95ee\u4e86\u3002</p> <p>\u53ea\u6709\u5f53\u4e8b\u4e24\u4eba\u77e5\u9053\uff0c\u8fd9\u662f\u5979\u4eec\u5206\u5f00\u540e\u552f\u4e00\u7559\u5b58\u7684\u5ff5\u60f3\uff0c\u662f\u4e00\u51c6\u627f\u8bfa\uff0c\u4ea6\u662f\u5c06\u8fc7\u53bb\u548c\u73b0\u5728\u8054\u7ed3\u5728\u4e00\u8d77\u7684\u67a2\u7ebd\u3002</p> <p>\u674e\u7ec7\u70df\u671b\u5251\u51fa\u5947\uff0c\u987e\u4e0d\u4e0a\u65f6\u95f4\u7684\u6d41\u901d\uff0c\u5979\u8fd8\u8bb0\u5f97\u9648\u5343\u8bed\u66fe\u7ecf\u5728\u706b\u9505\u5e97\u5bf9\u5979\u6253\u8da3\uff0c\u8fd8\u8bb0\u5f97\u5979\u4eec\u5728\u540c\u4e00\u7247\u661f\u7a7a\u4e0b\u8bb8\u613f\uff0c\u8fd8\u8bb0\u5f97\u5979\u88ab\u9648\u5343\u8bed\u62c9\u53bb\u770b\u9f99\u6ce1\u6ce1\u7136\u540e\u5410\u69fd\u5979\u5e7c\u7a1a......</p> <p>\u4e0d\u5f97\u4e0d\u627f\u8ba4\uff0c\u5728\u674e\u7ec7\u70df\u51fa\u4efb\u52a1\u4e0d\u51fa\u610f\u5916\u78b0\u9762\u7684\u90a3\u4e00\u523b\uff0c\u6b22\u559c\u3001\u9178\u6da9\u3001\u6000\u5ff5\u3001\u5c40\u4fc3\u63c9\u6742\u5728\u4e00\u8d77\uff0c\u4e00\u80a1\u8bf4\u4e0d\u6e05\u9053\u4e0d\u660e\u7684\u60c5\u7eea\u5835\u5728\u80f8\u53e3\u3002</p> <p>\u65e2\u5e86\u5e78\u518d\u6b21\u76f8\u89c1\uff0c\u53c8\u9057\u61be\u7269\u662f\u4eba\u975e\uff0c\u60f3\u8981\u9760\u8fd1\uff0c\u53c8\u5bb3\u6015\u6253\u7834\u5f53\u4e0b\u7684\u5e73\u8861\u3002\u5728\u7ba1\u7406\u5458\u548c\u4f69\u4e3d\u5361\u9762\u524d\uff0c\u8bc0\u7684\u8138\u4e0a\u770b\u4e0d\u51fa\u534a\u70b9\u6ce2\u6f9c\uff0c\u76f8\u53cd\u53ea\u6709\u9648\u5343\u8bed\u638c\u5fc3\u6b7b\u6b7b\u6525\u7d27\u5251\u67c4\uff0c\u767e\u822c\u6ecb\u5473\u5728\u5fc3\u5e95\u53cd\u590d\u62c9\u626f\uff0c\u8bf4\u4e0d\u6e05\u662f\u751c\uff0c\u8fd8\u662f\u82e6\u3002</p> <p>\u4e0d\u8fc7\u8fd9\u4e9b\u590d\u6742\u7684\u5c0f\u52a8\u4f5c\u5c0f\u5fc3\u601d\u5df2\u7136\u8fc7\u53bb\uff0c\u5982\u4eca\uff0c\u5251\u56de\u6765\u4e86\uff0c\u4eba\u4e5f\u56de\u6765\u4e86\uff0c\u56f0\u6270\u5979\u591a\u5e74\u7684\u751a\u5927\u88c2\u9699\u4e5f\u88ab\u5b8c\u5168\u5c01\u5370\u4e86\uff0c\u5c18\u57c3\u843d\u5b9a\u7684\u611f\u89c9\u4ee4\u5979\u677e\u4e86\u4e00\u53e3\u6c14\uff0c\u5fc3\u91cc\u60f3\u5230\u9648\u5343\u8bed\u5728\u7ec8\u672b\u5730\u8fc7\u5f97\u4e0d\u9519\u7684\u72b6\u51b5\u540e\uff0c\u5634\u89d2\u6b62\u4e0d\u4f4f\u5730\u4e0a\u626c\u3002</p> <p>\u5979\u4ecd\u7136\u6ca1\u6709\u627f\u8ba4......\u96be\u820d\u96be\u5206\u3001\u5fc3\u7167\u4e0d\u5ba3\u3002</p> <p>\u2014\u2014\u5f80\u4e8b\u5c31\u8fd9\u6837\u6de1\u4e86\u75d5\u8ff9\uff0c\u8fd9\u4e0b\u9648\u5343\u8bed\u56de\u6765\u4e86\u3002</p> <p>2166\u2014\u2014\u2014\u2014End.</p>"},{"location":"blog/archive/2026/","title":"2026","text":""},{"location":"blog/category/%E9%9A%8F%E7%AC%94/","title":"\u968f\u7b14","text":""},{"location":"blog/category/%E5%A4%87%E5%BF%98/","title":"\u5907\u5fd8","text":""},{"location":"blog/category/%E9%A5%AD/","title":"\u996d","text":""}]}